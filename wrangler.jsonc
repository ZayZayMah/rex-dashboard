{
  "name": "rex",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["python_workers"],

  // Keep variables/secrets you add in the Cloudflare dashboard when deploying from Git.
  "keep_vars": true,

  // Static website (HTML/CSS/JS) is served from /public.
  // Only /api/* and /auth/* run through the Python Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/auth/*", "/*/email"]
  },

  // Storage for sessions, server settings, premium flags and bot stats.
  // No id needed: Wrangler creates this KV namespace automatically on first deploy.
  "kv_namespaces": [{ "binding": "REX_KV" }],

  // Non-secret settings only. Real secrets go in Cloudflare -> Settings -> Variables and Secrets.
  "vars": {
    // Permissions requested when someone adds REX to a server (8 = Administrator).
    // Change to the exact permission number your bot needs.
    "INVITE_PERMISSIONS": "8"
  }
}
